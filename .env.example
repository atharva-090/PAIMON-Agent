# Copy this file to ".env" (same folder) and fill in the values.
# agent/config.py loads it automatically. Never commit your real .env.

# --- Gmail sending (send_email tool) ---------------------------------------
# One-time setup:
#   1. Turn ON 2-Step Verification for the Gmail account.
#   2. Google Account -> Security -> App passwords -> generate one (16 chars).
#   3. Put the address + that app password below (NOT your normal password).
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword

# The name outgoing email is signed with. SET THIS -- without it the agent has
# nothing to sign and either leaves a literal "[Your Name]" in the body or
# invents one. The fallback is the local part of GMAIL_ADDRESS, which is rarely
# what you want a recipient to read.
USER_NAME=Your Full Name

# Optional SMTP overrides (defaults are fine for Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# --- Real provider APIs (no mocker, no ChatGPT windows) ---------------------
# Set LLM_PROFILE plus that provider's key and the whole swarm switches: no
# session pinning, tools go to the API natively instead of being rendered into
# the prompt, and the agents get their native-tool-calling personas. The mocker
# does not need to be running.
#
# Cost warning: a real API is genuinely stateless, so the FULL conversation is
# re-sent on every step. A browser task is 30-40 steps each carrying a page
# snapshot, which grows quadratically -- turn the compaction knobs down before
# running one (SWARM_ORCH_COMPACT_AFTER / SWARM_CHILD_COMPACT_AFTER below).
# LLM_PROFILE=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# LLM_PROFILE=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
#
# LLM_PROFILE=gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash
#
# Per-request override instead of a global default: POST /api/chat with
# {"message": "...", "llm": "openai"}. The swarm is rebuilt when it changes.

# --- Token accounting -------------------------------------------------------
# Every model call's usage is written to agent/data/usage.jsonl, tagged with the
# agent that spent it. Read it with:  .venv/Scripts/python.exe usage_log.py
# The mocker reports no usage, so only real-provider runs appear there.
# Cost estimates use a local price table; override it (USD per 1M in/out):
# USAGE_PRICES=gpt-4o:2.5/10,gpt-4o-mini:0.15/0.6

# --- Context/cost knobs (matter most on a real API) -------------------------
# Chars of context before the orchestrator / a browser child is compacted.
# On the mocker compaction costs a cold ChatGPT chat, so these are deliberately
# high; on a real API compaction is free and saves money, so lower them.
# SWARM_ORCH_COMPACT_AFTER=40000
# SWARM_CHILD_COMPACT_AFTER=60000
# SWARM_MAX_CONTEXT_MSGS=80

# --- Local brain: K2-Horizon-3.7B (agent/local_model) -----------------------
# Start it with agent/start_k2.bat, then set LLM_PROFILE=local (or pick
# "brain: K2-Horizon (local)" in the web chat). Leave LLM_PROFILE unset to keep
# using the openai-mocker. See agent/local_model/README.md.
# LLM_PROFILE=local
# LOCAL_BASE_URL=http://127.0.0.1:8100/v1
# LOCAL_MODEL=k2-horizon-3.7b
# K2_MODEL_PATH=E:\hf-models\K2-Horizon-3.7B
# K2_QUANT=nf4
# K2_MAX_CONTEXT=16384
# K2_GPU_MEM=3.2GiB
# K2_REASONING_EFFORT=high
# K2_KV_QUANT=int4          # int4|int8|none - lets high effort fit at 16k

# --- Google Calendar + Meet (create_meeting tool) ---------------------------
# A Google Meet link can ONLY be created through the Calendar API -- clicking
# around meet.google.com produces nothing shareable. One-time setup:
#   1. Google Cloud Console -> new project -> enable the Google Calendar API.
#   2. Credentials -> Create credentials -> OAuth client ID -> "Desktop app".
#   3. Save the downloaded JSON as agent/data/google_credentials.json
#   4. .venv/Scripts/python.exe calendar_tools.py --login   (opens a browser once)
# The refresh token is then cached in agent/data/google_token.json.
#
# Optional: IANA timezone for events. Leave unset and each time is sent with
# this machine's real UTC offset, which is correct for one-off meetings.
# TIMEZONE=Asia/Kolkata
